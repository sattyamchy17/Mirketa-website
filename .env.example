# Copy this file to .env and fill in real values to test the Careers
# application form (src/components/CareerApplicationForm) locally via
# `npm run dev`. Never commit the real .env file — it's already
# gitignored. On a real deployment (Vercel, etc.), set these same
# variables in that platform's dashboard instead of a file.
#
# Provider: Microsoft 365 / Outlook, sending as
# sattyam.choudhary@mirketa.com through smtp.office365.com.
#
# Before this will authenticate, two things need to be true for that
# mailbox in the Microsoft 365 admin center:
#   1. "Authenticated SMTP" (SMTP AUTH) must be enabled for it —
#      Admin center > Users > Active users > sattyam.choudhary@mirketa.com
#      > Mail > Manage email apps > turn on "Authenticated SMTP".
#      Modern tenants ship with this OFF by default.
#   2. If that account has MFA / Security Defaults turned on, SMTP_PASS
#      below must be an app password generated for it
#      (https://mysignins.microsoft.com/security-info under "App
#      passwords"), not its normal sign-in password. Some organizations
#      disable app passwords entirely via Conditional Access — if so,
#      ask your Microsoft 365 admin, since Basic Auth SMTP can't work at
#      all in that case and sending would need to go through the
#      Microsoft Graph API (OAuth2) instead of SMTP.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sattyam.choudhary@mirketa.com
SMTP_PASS=that-mailbox-password-or-app-password
# Optional — defaults to SMTP_USER if omitted.
SMTP_FROM=sattyam.choudhary@mirketa.com
